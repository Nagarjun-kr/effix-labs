# Settings for Effix Discover (/discover) and the SEO audit (/seo-audit). Copy to .env.local, or set them on your host.

# Google PageSpeed Insights key for the speed test. Without it, Google's shared free quota is
# usually used up and the speed section shows "unavailable". Free key (25,000 tests/day):
# Google Cloud Console -> enable "PageSpeed Insights API" -> Credentials -> API key.
PAGESPEED_API_KEY=

# Groq key for the AI-written summary and tailored fixes. Without it, a plain summary is used.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Serper.dev key for brand search on nine platforms (Google results fetched by our server, so
# visitors never see a CAPTCHA). Free: 2,500 searches once at serper.dev; one audit = 9 searches.
# Without it, each platform card only shows an "Open this search on Google" link.
SERPER_API_KEY=
