# Settings for Effix Discover (/discover) and the SEO audit (/seo-audit). Copy to .env.local, or set them on your host.

# Google PageSpeed Insights key for the speed test. Without it, Google's shared free quota is
# usually used up and the speed section shows "unavailable". Free key (25,000 tests/day):
# Google Cloud Console -> enable "PageSpeed Insights API" -> Credentials -> API key.
PAGESPEED_API_KEY=

# Groq key for the AI-written summary and tailored fixes. Without it, a plain summary is used.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Serper.dev keys for the brand search (Google results fetched by our server, so visitors never see a CAPTCHA).
# One key:      SERPER_API_KEY=abc123
# Several keys: SERPER_API_KEYS=key1,key2,key3   (used in order; when one runs out of credit or stops working,
#               the next takes over automatically). Check what's left: node scripts/serper-keys.mjs
# One audit uses about 15 searches. A key is retired while SERPER_RESERVE searches remain (default 30), so an audit
# never runs out halfway.
SERPER_API_KEYS=
SERPER_RESERVE=30

# Optional alerts (key switched, fewer than SERPER_LOW_WARNING searches left, all keys used up). Paste a Discord,
# Slack or Google Chat webhook link. Without it, alerts go to the server log only.
ALERT_WEBHOOK_URL=
SERPER_LOW_WARNING=1000
