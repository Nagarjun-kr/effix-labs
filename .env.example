# Optional settings for Effix Discover (/discover). Copy to .env.local, or set them on your host.

# Google PageSpeed Insights key for the speed test. Without it, Google's shared free quota is
# usually used up and the speed section shows "unavailable". Free key (25,000 tests/day):
# Google Cloud Console -> enable "PageSpeed Insights API" -> Credentials -> API key.
PAGESPEED_API_KEY=

# Groq key for the AI-written summary and tailored fixes. Without it, a plain summary is used.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Google Programmable Search Engine ID for brand visibility (defaults to Effix's engine).
NEXT_PUBLIC_GOOGLE_PSE_ID=
