# Effix Labs: static HTML site (built with `next build` into out/). Works on Apache and LiteSpeed (MilesWeb).
Options -Indexes -MultiViews
DirectoryIndex index.html
# Page folders (about/) sit next to page files (about.html); don't let the folder add a trailing slash.
DirectorySlash Off
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# One address for the site: https://effixlabs.in (the old domain and www. forward here, keeping the page)
RewriteCond %{HTTP_HOST} ^(www\.)?effix\.co\.in$ [NC,OR]
RewriteCond %{HTTP_HOST} ^www\.effixlabs\.in$ [NC]
RewriteRule ^ https://effixlabs.in%{REQUEST_URI} [R=301,L]

# Always HTTPS
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Old static-site and duplicate service URLs -> current pages
RewriteRule ^index\.html$ / [R=301,L]
RewriteRule ^services/google-business-profile-growth(\.html|/index\.html|/)?$ /services/google-business-profile [R=301,L]
RewriteRule ^services/reddit-quora-(visibility|marketing)(\.html|/index\.html|/)?$ /services/reddit-marketing [R=301,L]
RewriteRule ^services/ai(-assisted)?-blog-seo(\.html|/index\.html|/)?$ /services/content-writing [R=301,L]
RewriteRule ^services/ai-search-visibility(\.html|/index\.html|/)?$ /services/seo-aeo-services [R=301,L]
RewriteRule ^services/([a-z-]+)/index\.html$ /services/$1 [R=301,L]
# Old address of the SEO audit tool page
RewriteRule ^seo-agency(/(.*))?$ /seo-audit-tool/$2 [R=301,L]

# .../index.html -> the folder (e.g. /seo-audit-tool/index.html -> /seo-audit-tool/)
RewriteCond %{THE_REQUEST} \s/+((?:[^?\s]*/)?)index\.html[\s?]
RewriteRule ^ /%1 [R=301,L]

# Typed .../page.html -> .../page (clean URL); only for requests made with .html, not internal rewrites
# Keep Google Search Console verification files directly reachable without a 301 redirect
RewriteCond %{REQUEST_URI} !^/google[0-9a-f]+\.html$
RewriteCond %{THE_REQUEST} \s/+([^?\s]+?)\.html[\s?]
RewriteRule ^ /%1 [R=301,L]

# Trailing slash -> no slash, when a matching page exists
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+)/$ /$1 [R=301,L]

# Folders with their own index.html (e.g. /casestudy) -> add the trailing slash
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+[^/])$ /$1/ [R=301,L]

# Serve clean URLs from the exported .html files: /about -> about.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+)$ $1.html [L]
</IfModule>

# Hidden files and folders (.env, .git, editor files) are never served; .well-known/ stays reachable
RedirectMatch 404 /\.(?!well-known/)

# Security headers
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://effix-search.effix-labs.workers.dev https://www.google-analytics.com https://www.googletagmanager.com https://api.github.com https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
</IfModule>

# Caching: hashed build files forever, pages always fresh
<IfModule mod_headers.c>
  <FilesMatch "\.(woff2|ttf|png|jpg|jpeg|webp|svg|ico|mp4|webm)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml application/xml text/plain
</IfModule>
