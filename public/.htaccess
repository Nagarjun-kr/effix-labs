# Effix Labs: static HTML site (built with `next build` into out/). Works on Apache and LiteSpeed (MilesWeb).
Options -Indexes -MultiViews
DirectoryIndex index.html
# Page folders (about/) sit next to page files (about.html); don't let the folder add a trailing slash.
DirectorySlash Off
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# Always HTTPS
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Old static-site and duplicate service URLs -> current pages
RewriteRule ^index\.html$ / [R=301,L]
RewriteRule ^services/google-business-profile-growth(\.html|/index\.html|/)?$ /services/google-business-profile [R=301,L]
RewriteRule ^services/reddit-quora-(visibility|marketing)(\.html|/index\.html|/)?$ /services/reddit-marketing [R=301,L]
RewriteRule ^services/ai(-assisted)?-blog-seo(\.html|/index\.html|/)?$ /services/content-writing [R=301,L]
RewriteRule ^services/ai-search-visibility(\.html|/index\.html|/)?$ /services/seo-aeo-services [R=301,L]
RewriteRule ^services/([a-z-]+)/index\.html$ /services/$1 [R=301,L]

# Typed .../page.html -> .../page (clean URL); only for requests made with .html, not internal rewrites
RewriteCond %{THE_REQUEST} \s/+([^?\s]+?)\.html[\s?]
RewriteRule ^ /%1 [R=301,L]

# Trailing slash -> no slash, when a matching page exists
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+)/$ /$1 [R=301,L]

# Serve clean URLs from the exported .html files: /about -> about.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+)$ $1.html [L]
</IfModule>

# Caching: hashed build files forever, pages always fresh
<IfModule mod_headers.c>
  <FilesMatch "\.(woff2|png|jpg|jpeg|webp|svg|ico|mp4|webm)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml application/xml text/plain
</IfModule>
